function buildBase() {
  // faint grid lines every 0.1 degrees, like a printed map
  for (let i = 0; i <= 3; i++) {
    const lat = 1.2 + i * 0.1;
    L.polyline([[lat, 103.4], [lat, 104.3]], { pane: 'basePane', color: '#FFFFFF', weight: 1, opacity: 0.8, interactive: false }).addTo(baseGroup);
  }
  for (let i = 0; i <= 7; i++) {
    const lng = 103.5 + i * 0.1;
    L.polyline([[1.0, lng], [1.6, lng]], { pane: 'basePane', color: '#FFFFFF', weight: 1, opacity: 0.8, interactive: false }).addTo(baseGroup);
  }
