// ---------------------------------------------------------------
// App state and prediction
// ---------------------------------------------------------------
const state = {
  loaded: false,
  current: {},
  weather: { temp: FALLBACKS.temp, rain: FALLBACKS.rain, wind: FALLBACKS.wind },
  stations: null,          // per-station readings: { temp: [...], rain: [...], wind: [...] }
  experimental: false,     // use the nearest weather station instead of the island-wide average
  mode: HOURLY ? 'hourly' : 'daily',   // hour-by-hour forecast (needs trained models) or tomorrow's daily average
  lead: 0,                 // hours ahead being shown in hourly mode
  baseTime: null,          // time of the latest NEA PSI reading
  lags: null,              // PSI 6 h and 24 h before the latest reading, per region
  lagNote: '',
  lastSelection: null
};

const hourlyActive = () => !!HOURLY && state.mode === 'hourly';

// Hour-by-hour prediction for a region (lead 0 is the latest actual reading)
function hourlyPredict(region, lead) {
  const now = state.current[region];
  if (lead <= 0) return Math.max(0, Math.round(now));
  const m = HOURLY[region] && HOURLY[region][String(lead)];
  if (!m) return Math.max(0, Math.round(now));
  const lg = (state.lags && state.lags[region]) || { l6: now, l24: now };   // steady trend if history is missing
  return Math.max(0, Math.round(m[0] + m[1] * now + m[2] * lg.l6 + m[3] * lg.l24));
}

// Time labels, in Singapore time
const FMT_TIME = new Intl.DateTimeFormat('en-SG', { weekday: 'short', hour: 'numeric', hour12: true, timeZone: 'Asia/Singapore' });
const FMT_HOUR = new Intl.DateTimeFormat('en-SG', { hour: 'numeric', hour12: true, timeZone: 'Asia/Singapore' });
const FMT_DAY  = new Intl.DateTimeFormat('en-SG', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Singapore' });
const cleanFmt = s => s.replace(',', '').replace(/\s+/g, ' ');
function timeAt(lead) { return new Date((state.baseTime || new Date()).getTime() + lead * 3600000); }
function timeLabel(lead) { return cleanFmt(FMT_TIME.format(timeAt(lead))); }
function tomorrowLabel() { return cleanFmt(FMT_DAY.format(timeAt(24))); }
// "YYYY-MM-DDTHH:mm:ss" in Singapore time, as NEA's date filter expects
function sgIso(d) {
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Singapore', year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).formatToParts(d);
  const g = k => parts.find(x => x.type === k).value;
  return g('year') + '-' + g('month') + '-' + g('day') + 'T' + (g('hour') === '24' ? '00' : g('hour')) + ':' + g('minute') + ':' + g('second');
}

function predictWith(region, w) {
  const m = MODELS[region];
  const f = {
    daily_rainfall_total: w.rain,
    mean_temperature: w.temp,
    maximum_temperature: w.temp,
    minimum_temperature: w.temp,
    mean_wind_speed: w.wind,
    max_wind_speed: w.wind,
    psi_today: state.current[region]
  };
  let p = m.intercept;
  for (const k in f) p += m[k] * f[k];
  return Math.max(0, Math.round(p));
}

// Prediction using the island-wide average weather (the validated default)
function predictFor(region) {
  return predictWith(region, state.weather);
}

// Nearest reading from a list of stations
function nearestStation(list, lat, lng) {
  let best = null, bestD = Infinity;
  list.forEach(s => {
    const d = haversineKm(lat, lng, s.lat, s.lng);
    if (d < bestD) { bestD = d; best = s; }
  });
  return best ? { s: best, km: bestD } : null;
}

// Experimental: weather from the station nearest to a location (null when switched off or unavailable)
function localWeather(lat, lng) {
  if (!state.experimental || !state.stations) return null;
  const t = nearestStation(state.stations.temp, lat, lng);
  const r = nearestStation(state.stations.rain, lat, lng);
  const w = nearestStation(state.stations.wind, lat, lng);
  if (!t || !r || !w) return null;
  return { temp: t.s.value, rain: r.s.value, wind: w.s.value, src: { temp: t, rain: r, wind: w } };
}

// Prediction for a location: its region's model, with local weather when the experimental option is on
function predictAt(lat, lng, region) {
  region = region || nearestRegion(lat, lng);
  if (hourlyActive()) return hourlyPredict(region, state.lead);
  const lw = localWeather(lat, lng);
  return predictWith(region, lw || state.weather);
}

// Value shown on a region's big bubble and shading
function regionValue(k) {
  return predictAt(REGION_CENTRES[k][0], REGION_CENTRES[k][1], k);
}

function nearestRegion(lat, lng) {
  let best = null, bestD = Infinity;
  REGION_KEYS.forEach(k => {
    const dLat = lat - REGION_CENTRES[k][0];
    const dLng = lng - REGION_CENTRES[k][1];
    const d = dLat * dLat + dLng * dLng;
    if (d < bestD) { bestD = d; best = k; }
  });
  return best;
}

function insideSingapore(lat, lng) {
  return lat >= SG_BOUNDS.south && lat <= SG_BOUNDS.north && lng >= SG_BOUNDS.west && lng <= SG_BOUNDS.east;
}

function colourForRegion(region) {
  return getGaugeColor(regionValue(region));
}

