function predLine(p) {
  if (hourlyActive()) {
    return state.lead === 0 ? 'PSI now (latest NEA reading): <b>' + p + '</b>'
                            : 'Predicted PSI at ' + timeLabel(state.lead) + ' (+' + state.lead + ' h): <b>' + p + '</b>';
  }
  return 'Predicted PSI tomorrow (' + tomorrowLabel() + ', daily average): <b>' + p + '</b>';
}

function showSelection(lat, lng, label, opts) {
  opts = opts || {};
  const panel = document.getElementById('selected');
  if (!insideSingapore(lat, lng)) {
    panel.innerHTML = 'That spot is outside Singapore. Pick somewhere on the island.';
    return;
  }
  if (!state.loaded) {
    panel.innerHTML = 'Live data is still loading, try again in a moment.';
    return;
  }
  state.lastSelection = { lat: lat, lng: lng, label: label, opts: opts };
  renderForecast();      // the chart and its summary follow the picked spot's region
  highlightActivity();
  const region = nearestRegion(lat, lng);
  const p = predictAt(lat, lng, region);
  const cur = Math.round(state.current[region]);
  const color = getGaugeColor(p);
  let html =
    '<b>' + label + '</b><br>' +
    REGION_NAMES[region] + ' region<br>' +
    predLine(p) + ' (' + getBand(p) + ')<br>' +
    'Current reading: ' + cur + '<br>' +
    'Outdoor activity: ' + getAdvice(p) + '<br>' +
    '<span style="color:#9A9A9A">' + activityIdeas(p) + '</span>';
  const lw = hourlyActive() ? null : localWeather(lat, lng);
  if (lw) {
    const base = predictFor(region), diff = p - base;
    html += '<br><span style="color:#9A9A9A">Experimental local weather: ' +
      lw.temp.toFixed(1) + ' &deg;C (' + lw.src.temp.s.name + ', ' + lw.src.temp.km.toFixed(1) + ' km), wind ' +
      lw.wind.toFixed(1) + ' km/h (' + lw.src.wind.s.name + ', ' + lw.src.wind.km.toFixed(1) + ' km), rain ' +
      lw.rain.toFixed(1) + ' mm (' + lw.src.rain.s.name + ', ' + lw.src.rain.km.toFixed(1) + ' km).<br>' +
      'Region-wide prediction would be ' + base + ' (' + (diff > 0 ? '+' : '') + diff + ' here).</span>';
  }

  panel.innerHTML = html;
  panel.style.borderLeft = '4px solid ' + color;

  if (opts.noPin) {
    if (selMarker) { map.removeLayer(selMarker); selMarker = null; }
    if (map.hasLayer(selPopup)) selPopup.setLatLng([lat, lng]).setContent(html);
    else selPopup.setLatLng([lat, lng]).setContent(html).openOn(map);
    return;
  }
  map.closePopup(selPopup);
  if (!selMarker) {
    selMarker = L.marker([lat, lng], { icon: pinIcon(color) }).addTo(map).bindPopup(html);
  } else {
    if (!map.hasLayer(selMarker)) selMarker.addTo(map);
    selMarker.setLatLng([lat, lng]);
    selMarker.setIcon(pinIcon(color));
    selMarker.setPopupContent(html);
  }
  selMarker.openPopup();
}

// ---------------------------------------------------------------
// Courts, playgrounds, football fields and sports complexes from OpenStreetMap (Overpass API)
// ---------------------------------------------------------------
const PLACE_KINDS = {
  bball: { shape: 'circle',  stroke: '#111111', radius: 7, box: 'toggle-bball', defaultName: 'Basketball court', plural: 'basketball courts' },
  play:  { shape: 'circle',  stroke: '#FFFFFF', radius: 6, box: 'toggle-play',  defaultName: 'Playground',       plural: 'playgrounds' },
  foot:  { shape: 'square',  box: 'toggle-foot', defaultName: 'Football field',  plural: 'football fields' },
  comp:  { shape: 'diamond', box: 'toggle-comp', defaultName: 'Sports complex',  plural: 'sports complexes' }
};

function overpassQuery(kind) {
  const b = '(1.15,103.6,1.48,104.1)';
  const wrap = body => '[out:json][timeout:30];(' + body + ');out center;';
  if (kind === 'bball') return wrap('node["leisure"="pitch"]["sport"="basketball"]' + b + ';way["leisure"="pitch"]["sport"="basketball"]' + b + ';');
  if (kind === 'play')  return wrap('node["leisure"="playground"]' + b + ';way["leisure"="playground"]' + b + ';');
  if (kind === 'foot')  return wrap('node["leisure"="pitch"]["sport"~"soccer|football"]' + b + ';way["leisure"="pitch"]["sport"~"soccer|football"]' + b + ';');
  const lei = '["leisure"~"^(sports_centre|stadium)$"]["indoor"!="yes"]';
  return wrap('node' + lei + b + ';way' + lei + b + ';relation' + lei + b + ';');
}

function shapeIcon(shape, color) {
  return L.divIcon({
    className: '',
    html: '<div class="shape ' + shape + '" style="background:' + color + '"></div>',
    iconSize: [18, 18], iconAnchor: [9, 9]
  });
}

async function loadPlaces(kind) {
  const res = await fetch('https://overpass-api.de/api/interpreter', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'data=' + encodeURIComponent(overpassQuery(kind))
  });
  if (!res.ok) throw new Error('Overpass returned ' + res.status);
  const json = await res.json();
  const group = L.layerGroup();
  const cfg = PLACE_KINDS[kind];
  let count = 0;
  json.elements.forEach(el => {
    const lat = el.lat !== undefined ? el.lat : (el.center ? el.center.lat : null);
    const lng = el.lon !== undefined ? el.lon : (el.center ? el.center.lon : null);
    if (lat === null || lng === null) return;
    const name = (el.tags && el.tags.name) ? el.tags.name : cfg.defaultName;
    const region = nearestRegion(lat, lng);
    const fill = state.loaded ? getGaugeColor(predictAt(lat, lng, region)) : '#BDBDBD';
    const marker = cfg.shape === 'circle'
      ? L.circleMarker([lat, lng], {
          renderer: canvasRenderer, radius: cfg.radius, color: cfg.stroke, weight: 2.5,
          fillColor: fill, fillOpacity: 1, bubblingMouseEvents: false, _region: region, _lat: lat, _lng: lng
        })
      : L.marker([lat, lng], { icon: shapeIcon(cfg.shape, fill), keyboard: false, _region: region, _lat: lat, _lng: lng, _shape: cfg.shape });
    marker.on('click', () => showSelection(lat, lng, name, { noPin: true })).addTo(group);
    count++;
  });
  placeLayers[kind] = { group: group, count: count };
}

function restylePlaces() {
  Object.keys(placeLayers).forEach(k => {
    placeLayers[k].group.eachLayer(m => {
      const c = getGaugeColor(predictAt(m.options._lat, m.options._lng, m.options._region));
      if (m.setStyle) m.setStyle({ fillColor: c });
      else m.setIcon(shapeIcon(m.options._shape, c));
    });
  });
}

async function togglePlaces(kind, on) {
  const status = document.getElementById('layer-status');
  const cfg = PLACE_KINDS[kind];
  if (!on) {
    applyLayers();
    status.textContent = '';
    return;
  }
  try {
    if (!placeLayers[kind]) {
      status.textContent = 'Loading ' + cfg.plural + ' from OpenStreetMap...';
      await loadPlaces(kind);
    }
    applyLayers();
    status.textContent = 'Showing ' + placeLayers[kind].count + ' ' + cfg.plural + ' from OpenStreetMap. Locations are volunteer-mapped and may be incomplete.';
  } catch (err) {
    status.textContent = 'Could not load ' + cfg.plural + ' (' + err.message + '). This data comes from an outside service that may be busy or blocked on this network. Untick and tick the box to try again.';
    document.getElementById(cfg.box).checked = false;
  }
}

// ---------------------------------------------------------------
// Load live data and redraw everything that depends on predictions
// ---------------------------------------------------------------
async function loadAndPredict() {
  const statusEl = document.getElementById('status');
  statusEl.textContent = 'Loading live data...';

  const results = await Promise.allSettled([
    fetchRegionalPsi(),
    fetchStationReadings('air-temperature'),
    fetchStationReadings('rainfall'),
    fetchStationReadings('wind-speed')
  ]);

  const fallbackUsed = [];
  const lists = {};
  if (results[0].status === 'fulfilled') {
    state.current = results[0].value.values;
    const ts = results[0].value.timestamp ? new Date(results[0].value.timestamp) : null;
    state.baseTime = ts && !isNaN(ts) ? ts : null;
  } else {
    state.baseTime = null;
    fallbackUsed.push('PSI');
    REGION_KEYS.forEach(k => { state.current[k] = FALLBACKS.psi; });
  }
  function pick(i, key, label) {
    const r = results[i];
    if (r.status === 'fulfilled' && r.value.length) {
      lists[key] = r.value;
      return r.value.reduce((a, s) => a + s.value, 0) / r.value.length;   // island-wide average
    }
    fallbackUsed.push(label);
    return FALLBACKS[key];
  }
  state.weather.temp = pick(1, 'temp', 'temperature');
  state.weather.rain = pick(2, 'rain', 'rainfall');
  state.weather.wind = pick(3, 'wind', 'wind speed');
  state.stations = (lists.temp && lists.rain && lists.wind) ? lists : null;
  state.loaded = true;

  redrawAll();

  const inputs = document.getElementById('inputs');
  inputs.style.display = 'block';
  inputs.innerHTML =
    '<div class="row"><span>Current temperature</span><span>' + state.weather.temp.toFixed(1) + ' &deg;C</span></div>' +
    '<div class="row"><span>Current rainfall reading</span><span>' + state.weather.rain.toFixed(1) + ' mm</span></div>' +
    '<div class="row"><span>Current wind speed</span><span>' + state.weather.wind.toFixed(1) + ' km/h</span></div>';

  statusEl.textContent = fallbackUsed.length > 0
    ? 'Note: ' + fallbackUsed.join(', ') + ' could not be reached just now, using a typical estimate instead.'
    : '';

  loadHaze();
  loadPsiHistory();
}

