  [['SUMATRA', -3.4, 101.6, 'land-label'], ['PENINSULAR MALAYSIA', 4.9, 101.7, 'land-label'],
   ['KALIMANTAN', -1.6, 112.3, 'land-label'], ['SARAWAK', 2.6, 112.4, 'land-label'],
   ['JAVA', -7.3, 109.2, 'land-label'], ['South China Sea', 4.0, 107.2, 'sea-label'],
