const GAUGE_STOPS = [
  {r:37,  g:99,  b:235},
  {r:22,  g:163, b:74},
  {r:250, g:204, b:21},
  {r:249, g:115, b:22},
  {r:220, g:38,  b:38},
  {r:147, g:51,  b:234},
  {r:107, g:20,  b:20}
];

function getGaugeColor(v) {
  const clamped = Math.max(0, Math.min(300, v));
  const segment = 300 / (GAUGE_STOPS.length - 1);
  const idx = Math.min(Math.floor(clamped / segment), GAUGE_STOPS.length - 2);
  const t = (clamped - idx * segment) / segment;
  const a = GAUGE_STOPS[idx], b = GAUGE_STOPS[idx + 1];
  const r = Math.round(a.r + (b.r - a.r) * t);
  const g = Math.round(a.g + (b.g - a.g) * t);
  const bl = Math.round(a.b + (b.b - a.b) * t);
  return 'rgb(' + r + ', ' + g + ', ' + bl + ')';
}

function getBand(v) {
  if (v <= 50) return 'Good';
  if (v <= 100) return 'Moderate';
  if (v <= 200) return 'Unhealthy';
