async function fetchJson(endpoint) {
  const res = await fetch('https://api-open.data.gov.sg/v2/real-time/api/' + endpoint);
  if (!res.ok) throw new Error(endpoint + ' request failed');
  const json = await res.json();
  if (json.code !== 0) throw new Error(endpoint + ' returned an error');
  return json.data;
}

async function fetchRegionalPsi() {
  const data = await fetchJson('psi');
  const item = data.items[0];
  const r = item.readings.psi_twenty_four_hourly;
  const out = {};
  REGION_KEYS.forEach(k => {
    if (typeof r[k] !== 'number') throw new Error('psi missing ' + k);
    out[k] = r[k];
  });
  return { values: out, timestamp: item.timestamp || item.updatedTimestamp || null };
}

// PSI at an earlier time (NEA's date filter returns the latest reading at that moment)
async function fetchPsiBefore(hoursBack) {
  const target = new Date(state.baseTime.getTime() - hoursBack * 3600000);
  const data = await fetchJson('psi?date=' + sgIso(target));
  const item = data.items && data.items[0];
  if (!item) throw new Error('no reading');
  if (Math.abs(new Date(item.timestamp) - target) > 90 * 60000) throw new Error('reading is for a different time');
  const r = item.readings.psi_twenty_four_hourly, out = {};
  REGION_KEYS.forEach(k => {
    if (typeof r[k] !== 'number') throw new Error('psi missing ' + k);
    out[k] = r[k];
  });
  return out;
}

async function loadPsiHistory() {
  if (!HOURLY || !state.baseTime) return;
  try {
    const both = await Promise.all([fetchPsiBefore(6), fetchPsiBefore(24)]);
    state.lags = {};
    REGION_KEYS.forEach(k => { state.lags[k] = { l6: both[0][k], l24: both[1][k] }; });
    state.lagNote = '';
  } catch (e) {
    state.lags = null;
    state.lagNote = 'Recent PSI history could not be loaded, so a steady trend is assumed.';
  }
  redrawAll();
}

// Per-station readings, joined with station locations. NEA reports wind in knots, but the models were
// trained on km/h, so values are converted using the unit the service reports.
async function fetchStationReadings(endpoint) {
  const data = await fetchJson(endpoint);
  const unit = String(data.readingUnit || '').toLowerCase();
  const factor = unit.indexOf('knot') >= 0 ? 1.852 : (unit.indexOf('m/s') >= 0 ? 3.6 : 1);
  const byId = {};
  (data.stations || []).forEach(s => {
    const loc = s.location || s;
    if (typeof loc.latitude === 'number' && typeof loc.longitude === 'number') byId[s.id] = { name: s.name, lat: loc.latitude, lng: loc.longitude };
  });
  const list = [];
  (data.readings[0].data || []).forEach(r => {
    const st = byId[r.stationId];
    if (st && typeof r.value === 'number') list.push({ name: st.name, lat: st.lat, lng: st.lng, value: r.value * factor });
  });
  if (!list.length) throw new Error(endpoint + ' had no usable station readings');
  return list;
}

