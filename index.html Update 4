}

function setGroup(g, on) {
  if (on) { if (!map.hasLayer(g)) g.addTo(map); }
  else if (map.hasLayer(g)) map.removeLayer(g);
}

function updateLabels() {
  const z = map.getZoom();
  setGroup(labelGroup, viewMode === 'sg' && styleMode === 'clean' && z >= 10.5 && z < DISPERSE_ZOOM);
}

// Zooming in: the big regional bubbles fade out and the town bubbles slide out from the big bubble's position.
// Zooming out reverses it. Offsets are set first so the animation starts from the right place.
function updateTownOffsets() {
  if (!map || viewMode !== 'sg') return;
  townItems.forEach(it => {
    const el = it.marker.getElement();
    if (!el || !el.firstChild) return;
    const own = map.latLngToContainerPoint([it.lat, it.lng]);
    const ctr = map.latLngToContainerPoint(REGION_CENTRES[it.region]);
    el.firstChild.style.setProperty('--dx', (ctr.x - own.x) + 'px');
    el.firstChild.style.setProperty('--dy', (ctr.y - own.y) + 'px');
  });
}

function updateDispersal() {
  if (!map) return;
  const z = map.getZoom(), sg = viewMode === 'sg';
  updateTownOffsets();
  document.getElementById('map').classList.toggle('dispersed', sg && z >= DISPERSE_ZOOM);
  townItems.forEach(it => {
    const el = it.marker.getElement();
    if (!el) return;
    const on = sg && z >= it.minZ;
    el.classList.toggle('town-on', on);
    if (el.firstChild) el.firstChild.classList.toggle('on', on);
  });
  document.getElementById('zoom-caption').style.display = (sg && z >= DISPERSE_ZOOM) ? 'block' : 'none';
  updateLabels();
}

// One place decides which layers are visible, from the view, map style and ticked boxes
function applyLayers() {
  const sg = viewMode === 'sg', clean = styleMode === 'clean';
  if (!clean) ensureTiles();
  if (tileLayer) setGroup(tileLayer, !clean);
  setGroup(baseGroup, sg && clean);
  setGroup(regionGroup, sg && clean);
  setGroup(streetShade, sg && !clean && document.getElementById('toggle-shade').checked);
  setGroup(regionalBase, !sg && clean);
  setGroup(badgeGroup, sg);
  setGroup(recGroup, sg && document.getElementById('toggle-rec').checked);
  setGroup(hazeGroup, !sg);
  setGroup(townGroup, sg);
  Object.keys(placeLayers).forEach(k => setGroup(placeLayers[k].group, sg && document.getElementById(PLACE_KINDS[k].box).checked));
  updateDispersal();
  renderWhenChip();
  renderForecast();
}

// Street map sources, tried in order. Some networks block one provider and not another, and some
// filters hang requests instead of refusing them, so each source also gets a time limit.
const TILE_PROVIDERS = [
  { name: 'CARTO Voyager', url: 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
    opts: { subdomains: 'abcd', maxZoom: 19, attribution: '&copy; OpenStreetMap contributors &copy; CARTO' } },
  { name: 'OpenStreetMap', url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
    opts: { maxZoom: 19, attribution: '&copy; OpenStreetMap contributors' } },
  { name: 'Esri World Street Map', url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}',
    opts: { maxZoom: 19, attribution: 'Tiles &copy; Esri' } }
];
let tileTimer = null;

function ensureTiles() {
  if (!tileLayer) loadTileProvider(0);
}

function loadTileProvider(i) {
  clearTimeout(tileTimer);
  if (tileLayer && map.hasLayer(tileLayer)) map.removeLayer(tileLayer);
  tileLayer = null;
  if (i >= TILE_PROVIDERS.length) {
    setMapStyle('clean');
    document.querySelector('input[name="mapstyle"][value="clean"]').checked = true;
    document.getElementById('map-note').textContent =
      'No street map source could be reached (they may be blocked on this network), so the clean map is shown instead.';
    return;
  }
  const prov = TILE_PROVIDERS[i];
  let errors = 0, loads = 0, gaveUp = false;
  const layer = L.tileLayer(prov.url, prov.opts);
  tileLayer = layer;
  const giveUp = () => {
    if (gaveUp || loads > 0 || styleMode !== 'street' || tileLayer !== layer) return;
    gaveUp = true;
    loadTileProvider(i + 1);
  };
  layer.on('tileload', () => { loads++; clearTimeout(tileTimer); });
  layer.on('tileerror', () => { errors++; if (errors >= 4 && loads === 0) giveUp(); });
  tileTimer = setTimeout(giveUp, 7000);
  if (styleMode === 'street') layer.addTo(map);
  document.getElementById('map-note').textContent = i === 0 ? '' :
    'Street map source: ' + prov.name + ' (the first source could not be reached).';
}

function setMapStyle(mode) {
  styleMode = mode;
  document.getElementById('map-note').textContent = '';
  drawRegionShapes();
  applyLayers();
}

function setViewMode(mode) {
  viewMode = mode;
  if (typeof renderHazeChip === 'function') renderHazeChip();
  map.closePopup();
  if (selMarker) { map.removeLayer(selMarker); selMarker = null; }
  // Fit first, then set the limits: raising the minimum zoom starts an animated zoom that would otherwise override the fit
  map.setMaxBounds(null);
  if (mode === 'regional') {
    map.setMinZoom(5);
    map.fitBounds(REG_FIT, { animate: false });
    map.setMaxBounds(REG_MAXB);
  } else {
    map.fitBounds(SG_FIT, { animate: false });
    map.setMinZoom(10);
    map.setMaxBounds(SG_MAXB);
  }
  document.getElementById('regional-caption').style.display = mode === 'regional' ? 'block' : 'none';
  applyLayers();
}

function buildRegionalBase() {
