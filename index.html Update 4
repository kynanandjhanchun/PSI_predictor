function drawTimeline() {
  const W = 660, H = 232, X0 = 40, X1 = 598, Y0 = 14, Y1 = 196;
  const series = {};
  let maxV = 0;
  REGION_KEYS.forEach(k => {
    series[k] = [];
    for (let h = 0; h <= 24; h++) { const v = hourlyPredict(k, h); series[k].push(v); if (v > maxV) maxV = v; }
  });
  const yMax = Math.max(120, Math.ceil((maxV + 10) / 50) * 50);
  const x = h => X0 + (X1 - X0) * h / 24;
  const y = v => Y1 - (Y1 - Y0) * Math.min(v, yMax) / yMax;
  const focus = focusRegion();
  let s = '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" role="img" aria-label="Predicted PSI for the next 24 hours, by region">';
  [[0, 50], [50, 100], [100, 200], [200, 300]].forEach(b => {
    if (b[0] >= yMax) return;
    const hi = Math.min(b[1], yMax);
    s += '<rect x="' + X0 + '" y="' + y(hi).toFixed(1) + '" width="' + (X1 - X0) + '" height="' + (y(b[0]) - y(hi)).toFixed(1) +
         '" fill="' + getGaugeColor((b[0] + b[1]) / 2) + '" opacity="0.16"/>';
  });
  for (let v = 0; v <= yMax; v += 50) {
    s += '<line x1="' + X0 + '" x2="' + X1 + '" y1="' + y(v).toFixed(1) + '" y2="' + y(v).toFixed(1) + '" stroke="#2A2A2A" stroke-width="1"/>' +
         '<text x="' + (X0 - 6) + '" y="' + (y(v) + 3).toFixed(1) + '" fill="#9A9A9A" font-size="10" text-anchor="end">' + v + '</text>';
  }
  for (let h = 0; h <= 24; h += 6) {
    s += '<text x="' + x(h).toFixed(1) + '" y="' + (Y1 + 16) + '" fill="#9A9A9A" font-size="10" text-anchor="middle">' +
         (h === 0 ? 'Now' : cleanFmt(FMT_HOUR.format(timeAt(h)))) + '</text>';
  }
  const order = REGION_KEYS.filter(k => k !== focus).concat([focus]);
  order.forEach(k => {
    const pts = series[k].map((v, h) => x(h).toFixed(1) + ',' + y(v).toFixed(1)).join(' ');
    const isF = k === focus;
    s += '<polyline points="' + pts + '" fill="none" stroke="' + (isF ? '#FFFFFF' : '#6F6F6F') + '" stroke-width="' + (isF ? 3 : 1.5) + '" stroke-linejoin="round"/>';
  });
  // region names at the right-hand end, nudged apart so they do not overlap
  const labels = REGION_KEYS.map(k => ({ k: k, y: y(series[k][24]) })).sort((a, b) => a.y - b.y);
  for (let i = 1; i < labels.length; i++) if (labels[i].y - labels[i - 1].y < 11) labels[i].y = labels[i - 1].y + 11;
  labels.forEach(l => {
    const isF = l.k === focus;
    s += '<text x="' + (X1 + 6) + '" y="' + (l.y + 3).toFixed(1) + '" fill="' + (isF ? '#FFFFFF' : '#9A9A9A') + '" font-size="10" font-weight="' + (isF ? 700 : 400) + '">' + REGION_NAMES[l.k] + '</text>';
  });
  const xl = x(state.lead);
  s += '<line x1="' + xl.toFixed(1) + '" x2="' + xl.toFixed(1) + '" y1="' + Y0 + '" y2="' + Y1 + '" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>';
  order.forEach(k => {
    const v = series[k][state.lead], isF = k === focus;
    s += '<circle cx="' + xl.toFixed(1) + '" cy="' + y(v).toFixed(1) + '" r="' + (isF ? 5 : 3.5) + '" fill="' + getGaugeColor(v) + '" stroke="#FFFFFF" stroke-width="' + (isF ? 2 : 1) + '"/>';
  });
  s += '</svg>';
  document.getElementById('fc-chart').innerHTML = s;
  return { series: series, focus: focus };
}

