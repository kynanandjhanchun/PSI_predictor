// ---------------------------------------------------------------
// Regional haze outlook (rule-based, uses Open-Meteo forecasts)
// ---------------------------------------------------------------
const toRad = d => d * Math.PI / 180;
const toDeg = r => r * 180 / Math.PI;

function haversineKm(lat1, lon1, lat2, lon2) {
  const R = 6371;
  const dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(a));
}

// Compass bearing (degrees clockwise from north) of the direction you travel from point 1 to point 2
function bearingDeg(lat1, lon1, lat2, lon2) {
  const dLon = toRad(lon2 - lon1);
  const y = Math.sin(dLon) * Math.cos(toRad(lat2));
  const x = Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) - Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
  return (toDeg(Math.atan2(y, x)) + 360) % 360;
}

function compass(deg) {
  const names = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];
  return names[Math.round(((deg % 360) + 360) % 360 / 22.5) % 16];
}

// Current hour in Singapore, in the same format as the API's time strings
function sgNowKey() {
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Singapore', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false
  }).formatToParts(new Date());
  const get = t => parts.find(p => p.type === t).value;
  const h = get('hour') === '24' ? '00' : get('hour');
  return get('year') + '-' + get('month') + '-' + get('day') + 'T' + h + ':00';
}

// Average wind over a window as a vector. Open-Meteo gives the direction the wind blows FROM,
// so the direction it blows TOWARD is 180 degrees opposite.
function meanWind(speeds, dirsFrom) {
  let u = 0, w = 0, n = 0;
  for (let i = 0; i < speeds.length; i++) {
    if (typeof speeds[i] !== 'number' || typeof dirsFrom[i] !== 'number') continue;
    const t = toRad(dirsFrom[i]);
    u += -speeds[i] * Math.sin(t);
    w += -speeds[i] * Math.cos(t);
    n++;
  }
  if (!n) return null;
  u /= n; w /= n;
  const toDir = (toDeg(Math.atan2(u, w)) + 360) % 360;
  return { speed: Math.hypot(u, w), toDir: toDir, fromDir: (toDir + 180) % 360 };
}

// Approximate PSI-equivalent of a PM2.5 concentration (ug/m3), from NEA's 24-hour PM2.5 bands
const PM25_BREAKS = [[0, 0], [12, 50], [55, 100], [150, 200], [250, 300], [350, 400], [500, 500]];
function pm25ToPsi(pm) {
  if (pm <= 0) return 0;
  for (let i = 1; i < PM25_BREAKS.length; i++) {
    const a = PM25_BREAKS[i - 1], b = PM25_BREAKS[i];
    if (pm <= b[0]) return a[1] + (pm - a[0]) * (b[1] - a[1]) / (b[0] - a[0]);
  }
  return 500;
}

function alignText(a) {
  if (a >= 0.7) return { key: 'toward', label: 'Toward Singapore' };
  if (a >= 0.3) return { key: 'partly', label: 'Partly toward' };
  return { key: 'away', label: 'Not toward' };
}

function analyseHaze(aq, wx) {
  const n = HAZE_SOURCES.length;
  if (!Array.isArray(aq) || !Array.isArray(wx) || aq.length < n + 1 || wx.length < n + 1) {
    throw new Error('unexpected response from the data service');
  }
  const times = wx[0].hourly.time;
  let start = times.indexOf(sgNowKey());
  if (start < 0) start = 0;
  const end = start + 24;

  const sgWind = meanWind(wx[n].hourly.wind_speed_10m.slice(start, end), wx[n].hourly.wind_direction_10m.slice(start, end));
  if (!sgWind) throw new Error('no wind forecast for Singapore');

  const sources = [];
  HAZE_SOURCES.forEach((s, i) => {
    const pmVals = (aq[i].hourly.pm2_5 || []).slice(start, end).filter(v => typeof v === 'number');
    const w = meanWind(wx[i].hourly.wind_speed_10m.slice(start, end), wx[i].hourly.wind_direction_10m.slice(start, end));
    if (!pmVals.length || !w) return;
    const pm = pmVals.reduce((a, b) => a + b, 0) / pmVals.length;
    const dist = haversineKm(s[2], s[3], SG_POINT[0], SG_POINT[1]);
    const bearing = bearingDeg(s[2], s[3], SG_POINT[0], SG_POINT[1]);
    // Wind must point from the source toward Singapore, both at the source and over Singapore
    const aSrc = w.speed >= 1 ? Math.max(0, Math.cos(toRad(w.toDir - bearing))) : 0;
    const aSg = sgWind.speed >= 1 ? Math.max(0, Math.cos(toRad(sgWind.toDir - bearing))) : 0;
    const align = Math.min(aSrc, aSg);
    const speed = (w.speed + sgWind.speed) / 2;
    const hours = dist / Math.max(speed, 3);
    sources.push({ name: s[0], country: s[1], lat: s[2], lon: s[3], pm: pm, psiEq: pm25ToPsi(pm),
                   wind: w, dist: dist, bearing: bearing, align: align, hours: hours });
  });
  if (!sources.length) throw new Error('no usable forecast data');

  // Outlook rules
  const risk = s => s.psiEq * s.align;
  const high = sources.filter(s => s.psiEq >= 100 && s.align >= 0.7 && s.hours <= 48);
  const modA = sources.filter(s => s.psiEq >= 100 && s.align >= 0.3 && s.hours <= 72);
  const modB = sources.filter(s => s.psiEq >= 75 && s.align >= 0.7 && s.hours <= 48);
  const best = list => list.slice().sort((a, b) => risk(b) - risk(a))[0];

  let level = 'low', headline;
  if (high.length) {
    level = 'high';
    const t = best(high);
    headline = 'Poor air near ' + t.name + ' (' + t.country + ') is likely to be carried toward Singapore, roughly ' +
               Math.round(t.hours) + ' hours away at current wind speeds.';
  } else if (modA.length) {
    level = 'moderate';
    const t = best(modA);
    headline = 'Poor air is forecast near ' + t.name + ' (' + t.country + ') and the wind is partly favourable for it to reach Singapore.';
  } else if (modB.length) {
    level = 'moderate';
    const t = best(modB);
    headline = 'Elevated particle levels near ' + t.name + ' (' + t.country + ') are upwind of Singapore.';
  } else {
    const poor = sources.filter(s => s.psiEq >= 100).sort((a, b) => b.psiEq - a.psiEq);
    if (poor.length) {
      const far = poor.filter(s => s.align >= 0.3).sort((a, b) => risk(b) - risk(a))[0];
      headline = far
        ? 'Poor air is forecast near ' + far.name + ' and the wind points toward Singapore, but it is about ' + Math.round(far.hours) +
          ' hours away at current wind speeds, so it is unlikely to arrive soon.'
        : 'Poor air is forecast near ' + poor[0].name + ', but the wind is not blowing toward Singapore.';
    } else {
      headline = 'No poor air quality is forecast at the places checked upwind of Singapore.';
    }
  }

  hazeState.sources = sources;
  hazeState.sg = sgWind;
  hazeState.level = level;
  hazeState.headline = headline;
}

async function loadHaze() {
  hazeState.loaded = false;
  hazeState.error = null;
  renderHazePanel();
  try {
    const lats = HAZE_SOURCES.map(s => s[2]).concat([SG_POINT[0]]).join(',');
    const lons = HAZE_SOURCES.map(s => s[3]).concat([SG_POINT[1]]).join(',');
    const tz = 'Asia%2FSingapore';
    const [aqRes, wxRes] = await Promise.all([
      fetch('https://air-quality-api.open-meteo.com/v1/air-quality?latitude=' + lats + '&longitude=' + lons + '&hourly=pm2_5&forecast_days=3&timezone=' + tz),
      fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lats + '&longitude=' + lons + '&hourly=wind_speed_10m,wind_direction_10m&forecast_days=3&timezone=' + tz)
    ]);
    if (!aqRes.ok || !wxRes.ok) throw new Error('the data service returned an error (' + (!aqRes.ok ? aqRes.status : wxRes.status) + ')');
    analyseHaze(await aqRes.json(), await wxRes.json());
    hazeState.loaded = true;
  } catch (err) {
    hazeState.error = err.message;
    hazeState.loaded = false;
  }
  renderHazePanel();
  drawHazeLayer();
}

const HAZE_LEVELS = {
  low:      { label: 'LOW',      color: '#2563EB' },
  moderate: { label: 'MODERATE', color: '#F97316' },
  high:     { label: 'HIGH',     color: '#DC2626' }
};

function renderHazeChip() {
  const chip = document.getElementById('haze-chip');
  if (hazeState.error) {
    chip.style.display = 'flex';
    chip.innerHTML = '<span class="haze-badge" style="background:#444">UNAVAILABLE</span><span>Regional haze outlook could not be loaded.</span>';
    return;
  }
  if (!hazeState.loaded) { chip.style.display = 'none'; return; }
  const lv = HAZE_LEVELS[hazeState.level];
  chip.style.display = 'flex';
  chip.innerHTML = '<span style="color:#9A9A9A">Regional haze outlook</span><span class="haze-badge" style="background:' + lv.color + '">' + lv.label + '</span>' +
                   '<span class="more">' + (viewMode === 'regional' ? 'details below' : 'view regional map &rsaquo;') + '</span>';
}

function renderHazePanel() {
  renderHazeChip();
  const body = document.getElementById('haze-body');
  if (hazeState.error) {
    body.innerHTML = 'Regional haze data could not be loaded just now (' + hazeState.error + '). It comes from an outside service (Open-Meteo) that may be busy or blocked on this network. Press Refresh to try again.';
    return;
  }
  if (!hazeState.loaded) { body.textContent = 'Loading regional air quality and wind forecasts...'; return; }
  const H = hazeState, lv = HAZE_LEVELS[H.level];
  let html = '<div><span class="haze-badge" style="background:' + lv.color + '">' + lv.label + '</span> ' +
             '<span class="haze-headline">' + H.headline + '</span></div>' +
             '<div style="margin-top:6px">Wind over Singapore (next 24 hours, average): from <b>' + compass(H.sg.fromDir) +
             '</b> at <b>' + Math.round(H.sg.speed) + ' km/h</b>.</div>';

  const rows = H.sources.slice().sort((a, b) => (b.psiEq * b.align) - (a.psiEq * a.align) || b.psiEq - a.psiEq).slice(0, 5);
  html += '<table class="haze-table"><tr><th>Place</th><th>PM2.5</th><th>PSI-equiv.</th><th>Wind</th><th>Distance</th><th>Travel time*</th></tr>' +
    rows.map(s => {
      const a = alignText(s.align);
      return '<tr><td>' + s.name + '</td><td>' + Math.round(s.pm) + ' &micro;g/m&sup3;</td><td><b style="color:#FFFFFF">' + Math.round(s.psiEq) +
             '</b></td><td><span class="tag ' + a.key + '">' + a.label + '</span></td><td>' + Math.round(s.dist) + ' km</td><td>' +
             (s.align >= 0.3 ? 'about ' + Math.round(s.hours) + ' h' : '-') + '</td></tr>';
    }).join('') + '</table>' +
    '<div class="guide-note">*Rough estimate at current 10 m wind speeds, shown only where the wind is at least partly toward Singapore. Showing the five places of most concern out of ' + H.sources.length + ' checked.</div>';
  if (H.level !== 'low') {
    html += '<div class="guide-note" style="color:#FDBA74">The PSI predictions on this page use local weather only, so they may underestimate tomorrow\'s PSI while this outlook is above Low.</div>';
  }
  body.innerHTML = html;
}

// A line with an arrow head, drawn from a point in the direction the wind blows toward
function arrowLayers(lat, lon, toDir, speed, color, weight) {
  const rad = toRad(toDir);
  const off = 0.3, len = Math.min(1.8, 0.35 + speed * 0.045);
  const sLat = lat + off * Math.cos(rad), sLon = lon + off * Math.sin(rad);
  const eLat = sLat + len * Math.cos(rad), eLon = sLon + len * Math.sin(rad);
  const head = 0.3, a1 = rad + Math.PI - 0.5, a2 = rad + Math.PI + 0.5;
  return [
    L.polyline([[sLat, sLon], [eLat, eLon]], { pane: 'hazePane', color: color, weight: weight, interactive: false }),
    L.polygon([[eLat, eLon], [eLat + head * Math.cos(a1), eLon + head * Math.sin(a1)], [eLat + head * Math.cos(a2), eLon + head * Math.sin(a2)]],
              { pane: 'hazePane', color: color, weight: 1, fillColor: color, fillOpacity: 1, interactive: false })
  ];
}

function hazePopup(s) {
  const a = alignText(s.align), band = getBand(s.psiEq);
  return '<b>' + s.name + '</b><br>' + s.country + '<br>' +
    'Forecast PM2.5 (next 24 h): <b>' + Math.round(s.pm) + ' &micro;g/m&sup3;</b><br>' +
    'PSI-equivalent: <b>' + Math.round(s.psiEq) + '</b> (' + band + ')<br>' +
    'Wind here: from ' + compass(s.wind.fromDir) + ' at ' + Math.round(s.wind.speed) + ' km/h<br>' +
    'Distance to Singapore: ' + Math.round(s.dist) + ' km<br>' +
    'Wind direction: <b>' + a.label + '</b>' + (s.align >= 0.3 ? ' (about ' + Math.round(s.hours) + ' h)' : '');
}

function hzIcon(label, num, color, cls) {
  return L.divIcon({
    className: '',
    html: '<div class="hz-wrap"><div class="hz ' + (cls || '') + '" style="border-color:' + color + '">' + num + '</div><div class="hz-name">' + label + '</div></div>',
    iconSize: [70, 54], iconAnchor: [35, 17]
  });
}

function drawHazeLayer() {
  hazeGroup.clearLayers();
  if (!hazeState.loaded) return;
  const H = hazeState;
  // dashed lines from places where the wind points toward Singapore and the air is not clean
  H.sources.forEach(s => {
    if (s.align >= 0.3 && s.psiEq >= 75) {
      const strong = s.align >= 0.7 && s.psiEq >= 100;
      L.polyline([[s.lat, s.lon], SG_POINT], {
        pane: 'hazePane', color: strong ? '#DC2626' : '#F97316', weight: strong ? 4 : 3, dashArray: '8 6', opacity: 0.9, interactive: false
      }).addTo(hazeGroup);
    }
  });
  // wind arrows
  H.sources.forEach(s => arrowLayers(s.lat, s.lon, s.wind.toDir, s.wind.speed, '#33414D', 2).forEach(l => l.addTo(hazeGroup)));
  arrowLayers(SG_POINT[0], SG_POINT[1], H.sg.toDir, H.sg.speed, '#111111', 3).forEach(l => l.addTo(hazeGroup));
  // place markers
  H.sources.forEach(s => {
    L.marker([s.lat, s.lon], { icon: hzIcon(s.name, Math.round(s.psiEq), getGaugeColor(s.psiEq)), keyboard: false })
      .bindPopup(hazePopup(s)).addTo(hazeGroup);
  });
  L.marker(SG_POINT, { icon: hzIcon('Singapore', 'SG', '#FFFFFF', 'sg'), keyboard: false })
    .bindPopup('<b>Singapore</b><br>Wind over Singapore (next 24 h average): from ' + compass(H.sg.fromDir) + ' at ' + Math.round(H.sg.speed) + ' km/h<br>Regional haze outlook: <b>' + HAZE_LEVELS[H.level].label + '</b>')
    .addTo(hazeGroup);
}

// ---------------------------------------------------------------
// Start up
// ---------------------------------------------------------------
function buildLegend() {
  const stops = GAUGE_STOPS.map(s => 'rgb(' + s.r + ',' + s.g + ',' + s.b + ')').join(', ');
  document.getElementById('legend-bar').style.background = 'linear-gradient(to right, ' + stops + ')';
}

function buildRecGuide() {
  const samples = [[30, 'Good', '0\u201350'], [75, 'Moderate', '51\u2013100'], [150, 'Unhealthy', '101\u2013200'], [250, 'Very unhealthy', '201\u2013300']];
  document.getElementById('rec-guide-rows').innerHTML = samples.map(s =>
    '<div class="guide-row"><div class="spot" style="border-color:' + getGaugeColor(s[0]) + '">' + s[0] + '</div>' +
    '<div><b>' + s[1] + '</b> (PSI ' + s[2] + ')<br>' + getAdvice(s[0]) + '</div></div>'
  ).join('');
}

function locateUser() {
  const panel = document.getElementById('selected');
  if (!navigator.geolocation) {
    panel.innerHTML = 'Your browser does not support location lookup.';
    return;
  }
  panel.innerHTML = 'Finding your location...';
  navigator.geolocation.getCurrentPosition(
    pos => {
      const lat = pos.coords.latitude, lng = pos.coords.longitude;
      if (!insideSingapore(lat, lng)) {
        panel.innerHTML = 'Your location appears to be outside Singapore.';
        return;
      }
      map.setView([lat, lng], 14);
      showSelection(lat, lng, 'Your location');
    },
    () => { panel.innerHTML = 'Could not get your location. Check that location access is allowed for this page.'; }
  );
}

window.addEventListener('error', e => {
  document.getElementById('status').textContent = 'Something went wrong: ' + e.message;
});

if (typeof L === 'undefined') {
  document.getElementById('status').textContent = 'The map library could not be loaded. Check your internet connection and refresh.';
} else {
  buildLegend();
  buildRecGuide();
  buildActivityGuide();
  initMap();
  document.querySelectorAll('input[name="mapstyle"]').forEach(r =>
    r.addEventListener('change', e => { if (e.target.checked) setMapStyle(e.target.value); }));
  document.getElementById('toggle-rec').addEventListener('change', applyLayers);
  document.getElementById('toggle-shade').addEventListener('change', applyLayers);
  if (HOURLY) document.getElementById('fmode-group').style.display = 'flex';
  document.getElementById('toggle-exp').disabled = hourlyActive();
  document.getElementById('lead-slider').addEventListener('input', e => setLead(parseInt(e.target.value, 10)));
  document.querySelectorAll('.fc-quick button').forEach(b =>
    b.addEventListener('click', () => setLead(parseInt(b.getAttribute('data-lead'), 10))));
  document.querySelectorAll('input[name="fmode"]').forEach(r => r.addEventListener('change', e => {
    if (!e.target.checked) return;
    state.mode = e.target.value;
    document.getElementById('toggle-exp').disabled = hourlyActive();
    if (state.loaded) redrawAll();
  }));
  document.getElementById('toggle-exp').addEventListener('change', e => {
    state.experimental = e.target.checked;
    if (state.loaded) redrawAll();
  });
  document.getElementById('haze-chip').addEventListener('click', () => {
    document.querySelector('input[name="viewmode"][value="regional"]').checked = true;
    setViewMode('regional');
  });
  document.querySelectorAll('input[name="viewmode"]').forEach(r =>
    r.addEventListener('change', e => { if (e.target.checked) setViewMode(e.target.value); }));
  Object.keys(PLACE_KINDS).forEach(k =>
    document.getElementById(PLACE_KINDS[k].box).addEventListener('change', e => togglePlaces(k, e.target.checked)));
  document.getElementById('btn-refresh').addEventListener('click', loadAndPredict);
  document.getElementById('btn-locate').addEventListener('click', locateUser);
  loadAndPredict();
}
</script>
